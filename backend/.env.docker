NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgresql://bookshelf:bookshelf@db:5432/bookshelf?schema=public
JWT_ACCESS_SECRET=dev-only-access-secret-replace-before-deploy
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-before-deploy
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_USER_AGENT=Bookshelf/0.1.0 (local development; contact: local@example.com)
OPEN_LIBRARY_SEARCH_CACHE_TTL_HOURS=24
OPEN_LIBRARY_DETAIL_CACHE_TTL_HOURS=168
OPEN_LIBRARY_REQUEST_TIMEOUT_MS=8000
