{
  "name": "bookshelf",
  "version": "0.1.0",
  "private": true,
  "description": "Bookshelf full-stack personal reading tracker.",
  "workspaces": [
    "backend"
  ],
  "overrides": {
    "@hono/node-server": "1.19.13",
    "@prisma/dev": {
      "@hono/node-server": "1.19.13"
    },
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.2.0"
    },
    "cosmiconfig": {
      "js-yaml": "5.2.0"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w backend",
    "db:generate": "npm run prisma:generate -w backend",
    "db:migrate:dev": "docker compose run --rm backend npm run db:migrate:dev -w backend",
    "db:migrate:deploy": "docker compose run --rm backend npm run db:migrate:deploy -w backend",
    "db:seed": "docker compose run --rm backend npm run db:seed -w backend",
    "dev:backend": "npm run start:dev -w backend",
    "format": "npm run format --workspaces --if-present",
    "format:backend": "npm run format -w backend",
    "format:check": "npm run format:check --workspaces --if-present",
    "start:backend": "npm run start -w backend",
    "start:backend:prod": "npm run start:prod -w backend",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test -w backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:backend": "npm run lint -w backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:backend": "npm run typecheck -w backend",
    "docker:up": "docker compose up --build",
    "docker:up:prod": "docker compose -f docker-compose.yml up --build",
    "docker:down": "docker compose down",
    "docker:down:prod": "docker compose -f docker-compose.yml down",
    "docker:db": "docker compose up -d db",
    "docker:logs": "docker compose logs -f",
    "docker:restart:backend": "docker compose restart backend"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
