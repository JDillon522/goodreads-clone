# Preferred: create a local read-only database role and use it here.
# See README.md for the SQL grants.
BOOKSHELF_MCP_DATABASE_URL=postgresql://bookshelf_readonly:readonly-password@127.0.0.1:5433/bookshelf

# Defaults match docker-compose.override.yml.
# BOOKSHELF_MCP_DATABASE_URL=postgresql://bookshelf:bookshelf@127.0.0.1:5433/bookshelf

BOOKSHELF_MCP_SCHEMA=public
BOOKSHELF_MCP_MAX_ROWS=200
BOOKSHELF_MCP_STATEMENT_TIMEOUT_MS=5000
