# Bookshelf root environment.
# Copy this file to .env for local development. Docker Compose, backend host
# commands, Prisma, seeds, and the MCP server all read from the root .env.

# Database
POSTGRES_DB=bookshelf
POSTGRES_SCHEMA=public
POSTGRES_USER=bookshelf
POSTGRES_PASSWORD=bookshelf
POSTGRES_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
POSTGRES_CONTAINER_HOST=db
POSTGRES_CONTAINER_PORT=5432

# Backend API
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:4200
JWT_ACCESS_SECRET=dev-only-access-secret-replace-before-deploy
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-before-deploy
GUEST_SESSION_TTL_DAYS=7
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Seeded admin account
ADMIN_EMAIL=admin@bookshelf.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Password123!
ADMIN_DISPLAY_NAME=Bookshelf Admin

# Google Books
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_REQUEST_TIMEOUT_MS=8000

# Open Library enrichment
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_USER_AGENT=Bookshelf/0.1.0 (local development; contact: local@example.com)
OPEN_LIBRARY_SEARCH_CACHE_TTL_HOURS=24
OPEN_LIBRARY_DETAIL_CACHE_TTL_HOURS=168
OPEN_LIBRARY_REQUEST_TIMEOUT_MS=8000

# Read-only database MCP server
BOOKSHELF_MCP_POSTGRES_USER=bookshelf_readonly
BOOKSHELF_MCP_POSTGRES_PASSWORD=readonly-password
BOOKSHELF_MCP_SCHEMA=public
BOOKSHELF_MCP_MAX_ROWS=200
BOOKSHELF_MCP_STATEMENT_TIMEOUT_MS=5000
